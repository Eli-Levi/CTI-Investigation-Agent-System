              },
              {
                "key": "to",
                "value": "${__to:date:iso}"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "short"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter the whole dashboard to this session",
                    "targetBlank": false,
                    "url": "/d/claude-code-ops?var-session=${__data.fields.short}&${__url_time_range}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "title"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "short": 0,
              "started": 1,
              "last_seen": 2,
              "duration_min": 3,
              "title": 4,
              "cases": 5,
              "models": 6,
              "api_calls": 7,
              "output_tokens": 8,
              "tool_calls": 9,
              "tool_failures": 10
            }
          }
        }
      ]
